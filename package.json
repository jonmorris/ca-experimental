{
  "name": "cardboard-appendix",
  "version": "1.0.0",
  "description": "A static web platform for board game rules.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build:site": "eleventy",
    "build:search": "pagefind --site _site",
    "build": "npm run build:site && npm run build:search",
    "clean": "rm -rf _site",
    "verify:bgg": "node scripts/verify-bgg-ids.mjs",
    "verify:bgg:strict": "node scripts/verify-bgg-ids.mjs --strict",
    "verify": "npm run verify:links && npm run verify:bgg",
    "verify:links": "node scripts/verify-links.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0"
  }
}
