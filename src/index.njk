---
layout: layouts/page.njk
permalink: /
bodyClass: page page--home
---
<div class="home" data-pagefind-body>
  <header class="home__hero">
    <p class="eyebrow">{{ site.title }}</p>
    <h1 class="home__title">{{ site.tagline }}</h1>
    <p class="home__lede">{{ site.description }}</p>
  </header>

  <section class="home__section" aria-labelledby="games-title">
    <h2 class="section-title" id="games-title">
      Games
      <span class="section-title__count">{{ games | length }}</span>
    </h2>

    <ul class="game-grid">
      {% for slug, item in games %}
        <li class="game-tile">
          {#
            One image per game at an unpredictable aspect ratio, so the art is
            cropped to a fixed box and a scrim carries the title over it. The
            same image is blurred behind the crop, which fills the box for art
            that does not match the ratio instead of letterboxing it.
          #}
          <a class="game-tile__link" href="{{ item.url }}">
            <span class="game-tile__art">
              {% if item.meta.box_art %}
                <img class="game-tile__backdrop" src="{{ item.meta.box_art }}" alt="" aria-hidden="true" loading="lazy">
                <img class="game-tile__image" src="{{ item.meta.box_art }}" alt="" loading="lazy">
              {% endif %}
              <span class="game-tile__scrim" aria-hidden="true"></span>
              <span class="game-tile__heading">
                <span class="game-tile__title">{{ item.title }}</span>
                <span class="game-tile__meta">
                  {{ item.meta.designer }}{% if item.meta.year_published %} · {{ item.meta.year_published }}{% endif %}
                </span>
              </span>
            </span>
          </a>

          <div class="game-tile__body">
            <p class="game-tile__description">{{ item.meta.description }}</p>
            <ul class="chip-row">
              {% for type in item.contentTypes %}
                <li><a class="chip" href="{{ type.url }}">{{ type.label }}</a></li>
              {% endfor %}
              {% for expansion in item.expansions %}
                <li><a class="chip chip--muted" href="{{ expansion.contentTypes[0].url }}">{{ expansion.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </li>
      {% endfor %}
    </ul>
  </section>
</div>
