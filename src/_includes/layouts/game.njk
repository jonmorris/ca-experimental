---
layout: layouts/base.njk
---
{#
  Shared chrome for every in-game content page. Individual content-type
  layouts extend this rather than repeating breadcrumbs, page header and the
  Pagefind body wrapper.
#}
{% include "partials/breadcrumbs.njk" %}

<article class="article" data-pagefind-body>
  <header class="page-header">
    {% if expansion %}
      <p class="page-header__eyebrow">
        <a href="{{ game.url }}">{{ game.title }}</a>
        <span aria-hidden="true">·</span> {{ expansion.title }}
      </p>
    {% endif %}
    <h1 class="page-header__title">{{ title }}</h1>
    {% if subhead %}<p class="page-header__subhead">{{ subhead }}</p>{% endif %}
  </header>

  {{ content | safe }}
</article>
