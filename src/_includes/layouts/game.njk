---
layout: layouts/base.njk
---
{% from "partials/prev-next.njk" import prevNext %}
{#
  Shared chrome for every in-game content page.

  The shell is a two-column grid at wide viewports — sidebar beside content —
  collapsing to a single column with a sticky section bar below that. Content
  layouts extend this rather than repeating breadcrumbs, the page header and
  the Pagefind body wrapper.
#}
{% include "partials/section-bar.njk" %}

<div class="shell">
  {% include "partials/sidebar.njk" %}

  <main id="main" class="main" tabindex="-1">
    {#
      Breadcrumbs left, print right. A page-level action belongs on the page's
      own line, not in the heading tools — those sit beside one section and are
      already carrying two controls.
    #}
    <div class="page-top">
      {% include "partials/breadcrumbs.njk" %}
      <button type="button" class="print-button" data-print hidden>
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" focusable="false">
          <path d="M6 7.5V3h8v4.5M6 14H4.5A1.5 1.5 0 0 1 3 12.5v-3A1.5 1.5 0 0 1 4.5 8h11A1.5 1.5 0 0 1 17 9.5v3a1.5 1.5 0 0 1-1.5 1.5H14"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 12.5h8V17H6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <span class="print-button__label">Print</span>
      </button>
    </div>

    <article class="article"{% if not noIndex %} data-pagefind-body{% endif %}>
      <header class="page-header">
        {% if expansion %}
          <p class="eyebrow">
            <a href="{{ game.url }}">{{ game.title }}</a>
            <span aria-hidden="true">·</span> {{ expansion.title }}
          </p>
        {% endif %}
        <h1 class="page-title">{{ title }}</h1>
        {% if subhead %}<p class="page-subhead">{{ subhead }}</p>{% endif %}
      </header>

      {{ content | safe }}
    </article>

  </main>

  {#
    The right-hand rail, and the section pager in it.

    A column of the shell rather than anything inside the reading column: on a
    phone the pager is a bar across the foot of the screen, and at desktop
    widths it is a pair of links standing in the margin beside the measure.
    That margin is a column now — the one that matches the section list on the
    other side — so the pager belongs to it rather than to the article it sits
    beside.

    The rail is rendered on every in-game page, empty where there is nothing to
    put in it, because it is what holds the measure in the middle. The pager
    goes to the two long documents: the rulebook, and My Reference, which is as
    long as the reader has made it. The shorter ones are a screen or two and
    the sidebar or the sticky bar already covers them.
  #}
  <div class="shell__rail">
    {% if contentTypeSlug == "rulebook" or contentTypeSlug == "my-reference" %}
      {{ prevNext(contentType, "inline") }}
    {% endif %}
  </div>
</div>
