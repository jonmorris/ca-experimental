<!doctype html>
<html lang="{{ site.lang }}" data-design="{{ design or site.design }}">
  <head>
    <meta charset="utf-8">
    {#
      `interactive-widget=resizes-content` is the whole of the keyboard story.

      Without it, Android's default is that an on-screen keyboard shrinks the
      visual viewport and leaves the layout viewport alone — so `vh`, `dvh` and
      `position: fixed` all keep measuring a height that half the screen is no
      longer showing. The search panel is sized and placed from those, so with
      a keyboard up it ran past the bottom of the screen and its field went off
      the top. With this, the keyboard resizes the page itself and every length
      on it is already correct.

      It applies to the preferences panel, the jump sheet and the bookmarks
      drawer too, which are built the same way and had the same exposure.
    #}
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    {#
      A game's landing page is titled with the game itself, so naming the game
      again would only repeat it.
    #}
    <title>
      {%- if not title -%}
        {{ site.title }} · {{ site.tagline }}
      {%- elif game and contentTypeSlug != "landing" -%}
        {{ title }} · {{ game.title }} · {{ site.title }}
      {%- else -%}
        {{ title }} · {{ site.title }}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ pageDescription or subhead or (game.meta.description if game) or site.description }}">
    {#
      The canonical carries the deploy prefix like every other URL on the page.
      `HtmlBasePlugin` rewrites root-absolute hrefs and leaves absolute ones
      alone, and this one is absolute — so on a host that serves the site from
      a subpath it pointed at the prefix-less URL, which is nowhere.
    #}
    <link rel="canonical" href="{{ site.url }}{{ page.url | basePath }}">

    {% include "partials/social-meta.njk" %}

    {#
      Reading preferences are applied before first paint. This has to be inline
      and synchronous — a module would run after the page has already been
      drawn in the wrong theme, and a reader in a dim room would get a flash of
      white. It is the one place storage is read outside preferences.js, and it
      is deliberately tiny.
    #}
    <script>
      (function () {
        try {
          var raw = localStorage.getItem("cardboard-appendix:preferences");
          if (!raw) return;
          var stored = JSON.parse(raw);
          if (!stored || Number(stored.schemaVersion) > 1) return;
          var prefs = stored.preferences || {};
          var map = { theme: "data-theme", density: "data-density", face: "data-face", spacing: "data-spacing", focus: "data-focus" };
          /* `face` has no implicit value: see the note in preferences.js. */
          var implicit = { theme: "system", density: "comfortable", spacing: "normal", focus: "off" };
          for (var key in map) {
            var value = prefs[key];
            if (value && value !== implicit[key]) document.documentElement.setAttribute(map[key], value);
          }
        } catch (error) {
          /* No stored preferences, or storage is unavailable. Defaults apply. */
        }
      })();
    </script>

    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/tokens.css">
    <link rel="stylesheet" href="/assets/css/theme-editorial.css">
    <link rel="stylesheet" href="/assets/css/theme-precision.css">
    <link rel="stylesheet" href="/assets/css/base.css">
    <link rel="stylesheet" href="/assets/css/layout.css">
    <link rel="stylesheet" href="/assets/css/components.css">
    <link rel="stylesheet" href="/assets/css/content.css">
    <link rel="stylesheet" href="/assets/css/print.css" media="print">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <script type="module" src="/assets/js/site.js"></script>
    <noscript>
      {#
        Without scripting the overlays cannot open and search has no index, so
        the controls that would do nothing are removed and the menu is rendered
        open — the per-game nav stays reachable on a phone.
      #}
      <style>
        .menu-toggle, .icon-button, .search, .section-bar { display: none !important; }
        .site-menu[hidden] { display: block !important; }
        /* Rendered open, so it has to take its own room rather than hang over
           the page the way the dropdown does. */
        .site-menu { position: static !important; max-height: none !important; }
      </style>
    </noscript>
  </head>
  <body
    class="{{ bodyClass or 'page' }}"
    {% if game %}
      data-pagefind-filter="game:{{ game.slug }}"
      data-game="{{ game.slug }}"
      data-game-title="{{ game.title }}"
      {#
        Written as data, so HtmlBasePlugin does not rewrite it — it is stored
        unprefixed and `withBasePath` puts the prefix on at render time, the
        same contract the stored bookmark URLs keep.
      #}
      data-game-url="{{ game.url }}"
    {% endif %}
    {% if expansion %}
      data-expansion="{{ expansion.slug }}"
      data-expansion-title="{{ expansion.title }}"
    {% endif %}
    data-content-type="{{ contentTypeSlug or 'site' }}"
    data-base-path="{{ basePath }}"
  >
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "partials/header.njk" %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}

    {% include "partials/overlays.njk" %}

    <script type="application/json" data-palette-index>{{ paletteIndex | dump | safe }}</script>
  </body>
</html>
