---
layout: layouts/base.njk
---
<div class="shell shell--landing">
  {% include "partials/sidebar.njk" %}

  <main id="main" class="main" tabindex="-1">
    {% include "partials/breadcrumbs.njk" %}

    <div class="landing" data-pagefind-body>
      {#
        The cover is shown plainly beside the title rather than blurred up
        behind it. Nothing is laid over the art, so the type sits on the page's
        own surface and reads in the page's own colours.
      #}
      <header class="landing__hero">
        {% if game.meta.box_art %}
          <span class="landing__cover">
            <img src="{{ game.meta.box_art }}" alt="Box art for {{ game.title }}" sizes="260px">
          </span>
        {% endif %}

        <div class="landing__intro">
          <h1 class="landing__title">{{ game.title }}</h1>
          <p class="landing__description">{{ game.meta.description }}</p>
          {#
            The star is made here and nowhere else. This is the page about the
            game, so it is where a reader says "this is one of mine"; a star on
            all eighteen tiles would put a second target inside every card whose
            whole job is to be one.
          #}
          <div class="landing__actions">
            {% if game.hasRulebook %}
              <a class="button button--primary" href="{{ game.url }}rulebook/">Open the rulebook</a>
            {% endif %}
            <button type="button" class="button button--quiet favorite-toggle"
                    data-favorite-toggle aria-pressed="false" hidden>
              <span class="favorite-toggle__icon" data-favorite-icon></span>
              <span data-favorite-label>Favorite</span>
            </button>
          </div>
        </div>
      </header>

      <dl class="game-facts">
        {% if game.meta.designer %}
          <div class="game-facts__item"><dt>Designer</dt><dd>{{ game.meta.designer }}</dd></div>
        {% endif %}
        {% if game.meta.publisher %}
          <div class="game-facts__item"><dt>Publisher</dt><dd>{{ game.meta.publisher }}</dd></div>
        {% endif %}
        {% if game.meta.players %}
          <div class="game-facts__item"><dt>Players</dt><dd>{{ game.meta.players }}</dd></div>
        {% endif %}
        {% if game.meta.time %}
          <div class="game-facts__item"><dt>Play time</dt><dd>{{ game.meta.time }}</dd></div>
        {% endif %}
        {% if game.meta.year_published %}
          <div class="game-facts__item"><dt>Published</dt><dd>{{ game.meta.year_published }}</dd></div>
        {% endif %}
        {% if game.meta.bgg_id %}
          <div class="game-facts__item">
            <dt>BoardGameGeek</dt>
            <dd><a href="https://boardgamegeek.com/boardgame/{{ game.meta.bgg_id }}/">#{{ game.meta.bgg_id }}</a></dd>
          </div>
        {% endif %}
      </dl>

      {# A game can be on the shelf before anything has been written for it. #}
      {% if game.contentTypes.length %}
      <section class="landing__section" aria-labelledby="contents-title">
        <h2 class="section-title" id="contents-title">Contents</h2>
        <ul class="card-grid">
          {% for type in game.contentTypes %}
            <li class="card">
              <h3 class="card__title"><a href="{{ type.url }}">{{ type.label }}</a></h3>
              {% if type.subhead %}<p class="card__body">{{ type.subhead }}</p>{% endif %}
              {#
                Every other card counts what is in it at build time. My
                Reference holds whatever this reader has bookmarked, which only
                the browser knows — so it gets the same line from the same
                place in the card, filled in by the client and hidden until
                there is a number worth showing.
              #}
              {% if type.slug == "my-reference" %}
                <p class="card__meta" data-reference-count hidden></p>
              {% elif type.sections.length %}
                <p class="card__meta">{{ type.sections.length }} section{{ "s" if type.sections.length != 1 }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% for expansion in game.expansions %}
        <section class="landing__section" aria-labelledby="exp-title-{{ expansion.slug }}">
          <h2 class="section-title" id="exp-title-{{ expansion.slug }}">{{ expansion.title }}</h2>
          <ul class="card-grid">
            {% for type in expansion.contentTypes %}
              <li class="card">
                <h3 class="card__title"><a href="{{ type.url }}">{{ type.label }}</a></h3>
                {% if type.subhead %}<p class="card__body">{{ type.subhead }}</p>{% endif %}
                {% if type.sections.length %}
                  <p class="card__meta">{{ type.sections.length }} section{{ "s" if type.sections.length != 1 }}</p>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endfor %}

      {# Nothing to save yet if the game has no content to save from. #}
      {% if game.allContentTypes.length %}
        {% include "partials/bookmarks-panel.njk" %}
      {% endif %}

      {% if content | stripHtml %}
        <div class="prose">{{ content | safe }}</div>
      {% endif %}

      {#
        Where to go next.

        Ranked at build time by credits — designer first, then publisher — and
        topped up with whatever is left on the shelf so the row is never short.
        A tile says why it is there when there is a why; the ones filling in
        say nothing rather than claiming a connection they do not have. The
        heading is deliberately plain for the same reason: on a game whose
        designer and publisher are on nothing else here, "More like this" would
        be a promise the row cannot keep.

        Eight are written and four are shown. The four extra are not padding —
        `related-games.js` re-ranks this row against the games the reader has
        favourited and opened, and a re-rank with nothing held back could only
        shuffle what was already visible.

        Ignored by Pagefind: it is a way out of the page, not part of it, and
        indexing it would put every game's name in every other game's results.
      #}
      {% set relatedGames = related.games[game.slug] %}
      {% if relatedGames.length %}
        <section class="landing__section" aria-labelledby="related-title"
                 data-related-games data-pagefind-ignore>
          <h2 class="section-title" id="related-title">More games</h2>
          <ul class="game-grid game-grid--recent game-grid--related" data-related-list>
            {% for item in relatedGames %}
              {#
                Everything the re-rank sorts by travels on the tile, the way
                the shelf carries its own sort keys: the page is the index.
              #}
              <li class="game-tile"
                  data-game-slug="{{ item.slug }}"
                  data-order="{{ loop.index0 }}"
                  data-score="{{ item.score }}"
                  data-designers="{{ item.designers | join(' ') }}"
                  data-publishers="{{ item.publishers | join(' ') }}"
                  {% if loop.index0 >= related.shown %}hidden{% endif %}>
                <a class="game-tile__link" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {% if item.boxArt %}
                    <span class="game-tile__art">
                      <img class="game-tile__image" src="{{ item.boxArt }}" alt=""
                           sizes="220px" loading="lazy">
                    </span>
                  {% endif %}
                </a>
                <div class="game-tile__body">
                  <h3 class="game-tile__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  {% if item.reason %}<p class="game-tile__meta">{{ item.reason }}</p>{% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>

          {#
            Who made every game on the site, for the re-rank.

            The row is scored against the reader's favourites and history,
            which are games that are not on this page — so their credits have
            to be here to be compared with. Slugs only, no URLs, so there is no
            deploy prefix for it to lose travelling as data.
          #}
          <script type="application/json" data-related-affinity>{{ related.affinity | dump | safe }}</script>
        </section>
      {% endif %}
    </div>
  </main>
</div>
