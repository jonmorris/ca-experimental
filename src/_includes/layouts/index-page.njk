---
layout: layouts/game.njk
---
{#
  The book index: alphabetical terms, each pointing at one or more rulebook
  sections. Entries come from the file's `entries` frontmatter.
#}
{% if content | stripHtml %}
  <div class="prose prose--intro">{{ content | safe }}</div>
{% endif %}

{% set groups = contentType.entries | groupByInitial("term") %}

{% if groups.length %}
  <nav class="alpha-jump" aria-label="Jump to letter" data-pagefind-ignore>
    <ul class="alpha-jump__list">
      {% for group in groups %}
        <li><a href="#letter-{{ group.letter | slug }}">{{ group.letter }}</a></li>
      {% endfor %}
    </ul>
  </nav>

  {% for group in groups %}
    <section class="index-group" aria-labelledby="letter-{{ group.letter | slug }}">
      <h2 class="index-group__letter" id="letter-{{ group.letter | slug }}">{{ group.letter }}</h2>
      <ul class="index-list">
        {% for entry in group.items %}
          <li class="index-list__item">
            <span class="index-list__term">{{ entry.term }}</span>
            <ul class="index-list__refs">
              {% for ref in entry.refs %}
                {% set anchor = ref.anchor or ref.rule %}
                {% set section = game.rules | selectattr("slug", "equalto", ref.rule) | first %}
                <li>
                  <a href="{{ game.url }}rulebook/#{{ anchor }}">{{ ref.label or section.title or ref.rule }}</a>
                </li>
              {% endfor %}
            </ul>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
{% else %}
  <p class="empty-state">No index entries have been written for {{ game.title }} yet.</p>
{% endif %}
