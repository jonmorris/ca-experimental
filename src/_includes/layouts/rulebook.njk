---
layout: layouts/game.njk
---
{% from "partials/prev-next.njk" import prevNext %}

{% if contentType.sections.length %}
  <nav class="toc" id="rulebook-toc" aria-labelledby="rulebook-toc-title" data-pagefind-ignore>
    <h2 class="toc__title" id="rulebook-toc-title">Contents</h2>
    <ol class="toc__list">
      {% for section in contentType.sections %}
        <li><a href="#{{ section.slug }}">{{ section.title }}</a></li>
      {% endfor %}
    </ol>
  </nav>

  {{ prevNext(contentType, "inline") }}
{% endif %}

<div class="prose">
  {{ content | enhanceHeadings({
    bookmarkable: true,
    pageUrl: page.url,
    anchorAliases: contentType.anchorAliases
  }) | safe }}
</div>

{% if contentType.sections.length %}
  {{ prevNext(contentType, "inline") }}
  {{ prevNext(contentType, "fixed") }}
{% endif %}
