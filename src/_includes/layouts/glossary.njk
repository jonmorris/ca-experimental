---
layout: layouts/game.njk
---
{#
  The full glossary. Terms come from the file's `terms` frontmatter; each also
  gets its own deep-linkable page under `/glossary/{term-slug}/`.

  A term is bookmarkable, and it is the term rather than the letter heading
  above it that carries the control: the headings on this page are "A", "B",
  "C", generated here rather than written in the markdown, and saving "A" is
  no use to anyone. The unit a reader wants back is the definition.
#}
{% if content | stripHtml %}
  <div class="prose prose--intro">{{ content | safe }}</div>
{% endif %}

{% set groups = contentType.glossary | groupByInitial("term") %}

{% if groups.length %}
  <nav class="alpha-jump" aria-label="Jump to letter" data-pagefind-ignore>
    <ul class="alpha-jump__list">
      {% for group in groups %}
        <li><a href="#letter-{{ group.letter | slug }}">{{ group.letter }}</a></li>
      {% endfor %}
    </ul>
  </nav>

  {% for group in groups %}
    <section class="term-group" aria-labelledby="letter-{{ group.letter | slug }}">
      <h2 class="term-group__letter" id="letter-{{ group.letter | slug }}">{{ group.letter }}</h2>
      <dl class="term-list">
        {% for term in group.items %}
          <div class="term-list__item" id="{{ term.slug }}">
            <dt class="term-list__term">
              <a href="{{ game.url }}glossary/{{ term.slug }}/">{{ term.term }}</a>
              {% if contentType.bookmarkable %}
                <span class="heading-tools" data-pagefind-ignore>
                  {% bookmarkToggle term.slug, term.term, contentType.url %}
                </span>
              {% endif %}
            </dt>
            <dd class="term-list__definition">
              {% if term.short %}<p class="term-list__short">{{ term.short }}</p>{% endif %}
              {% if term.long %}<p class="term-list__long">{{ term.long }}</p>{% endif %}
            </dd>
          </div>
        {% endfor %}
      </dl>
    </section>
  {% endfor %}
{% else %}
  <p class="empty-state">No glossary terms have been written for {{ game.title }} yet.</p>
{% endif %}
