{#
  The header stays deliberately thin — at a table, chrome above the fold is
  chrome between you and the rule you are looking for. It carries identity on
  the left and four controls on the right, and nothing else. The section list
  lives in the sidebar (wide) or the sticky bar (narrow), not up here.
#}
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="/">
      <span class="site-logo__mark" aria-hidden="true">
        <svg class="site-logo__svg" viewBox="0 0 491 224" role="img"
             aria-hidden="true" focusable="false">
          <path d="M466.898 223.055H423.726L405.882 192.259H313.782L295.937 223.055H252.478L228.877 188.805L338.246 0H381.418L490.786 188.517L466.898 223.055ZM359.832 112.823L354.075 122.896H365.588L359.832 112.823Z" fill="#BC8230"/>
          <path d="M158.009 100.159C155.419 79.4363 146.497 63.8944 135.272 53.5331C105.627 52.6697 76.8459 77.1338 76.8459 118.003C76.8459 141.028 85.7681 158.297 98.4319 169.522C130.955 171.536 151.677 148.511 156.57 122.896H200.03L229.387 149.375C216.723 193.122 178.444 223.055 131.818 223.055H100.159C50.9428 223.055 0 185.639 0 114.262C0 48.3525 44.0353 0 103.037 0H132.969C176.717 0 213.557 25.6153 229.099 72.5288L198.303 100.159H158.009Z" fill="#BC8230"/>
          <path d="M466.898 223.055H423.726L405.882 192.259H313.782L295.937 223.055H252.478L228.877 188.805L338.246 0H381.418L490.786 188.517L466.898 223.055ZM370.193 130.667H301.406L372.495 7.77094H343.139L240.677 184.488H270.034L288.166 153.692H383.72L370.193 130.667ZM344.29 122.896L379.115 63.3188L465.171 211.542L481.289 188.517L379.403 12.6638L315.509 122.896H344.29ZM397.535 161.463H298.24L314.357 184.488H410.774L428.619 215.284H457.976L379.115 79.4363L364.724 104.476L397.535 161.463ZM240.965 192.259L256.795 215.284H287.303L271.473 192.259H240.965ZM278.093 187.654L293.635 210.391L306.874 187.654L291.044 164.917L278.093 187.654ZM359.832 112.823L354.075 122.896H365.588L359.832 112.823Z" fill="#191A17"/>
          <path d="M158.009 100.159C155.419 79.4363 146.497 63.8944 135.272 53.5331C105.627 52.6697 76.8459 77.1338 76.8459 118.003C76.8459 141.028 85.7681 158.297 98.4319 169.522C130.955 171.536 151.677 148.511 156.57 122.896H200.03L229.387 149.375C216.723 193.122 178.444 223.055 131.818 223.055H100.159C50.9428 223.055 0 185.639 0 114.262C0 48.3525 44.0353 0 103.037 0H132.969C176.717 0 213.557 25.6153 229.099 72.5288L198.303 100.159H158.009ZM7.77094 114.262C7.77094 178.444 51.5184 212.693 94.9781 215.572C60.7284 201.181 34.5375 166.356 34.5375 116.276C34.5375 67.9238 65.3335 32.5228 102.749 32.5228C129.228 32.5228 155.419 54.1088 163.478 89.7975L185.351 69.9384C171.536 32.5228 137.287 7.77094 102.749 7.77094C46.6256 7.77094 7.77094 55.5478 7.77094 114.262ZM69.075 118.291C69.075 77.4216 93.8269 50.655 125.774 46.6256C118.579 42.3084 110.52 40.2937 103.037 40.2937C71.0897 40.2937 42.3084 70.5141 42.3084 116.276C42.3084 178.444 84.0413 215.284 133.257 215.284C170.961 215.284 205.498 193.122 220.464 152.253L198.303 132.394C189.956 169.809 164.053 190.532 132.106 190.532C102.461 190.532 69.075 164.629 69.075 118.291ZM132.106 182.761C160.599 182.761 184.2 164.053 191.108 130.667H162.902C157.721 150.238 139.877 173.263 108.793 176.717C116.276 180.746 124.047 182.761 132.106 182.761ZM136.711 7.48312C159.736 17.2687 181.034 37.1278 192.259 67.0603H219.025C204.059 29.0691 170.385 8.92219 136.711 7.48312ZM194.849 92.3878L214.42 74.8313H191.971L172.4 92.3878H194.849Z" fill="#191A17"/>
        </svg>
      </span>
      <span class="site-logo__text">{{ site.title }}</span>
    </a>

    {% if game %}
      <span class="site-header__divider" aria-hidden="true"></span>
      <a class="site-header__game" href="{{ game.url }}">{{ game.title }}</a>
    {% endif %}

    <div class="site-header__actions">
      <button
        type="button"
        class="search-trigger"
        data-palette-toggle
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="{% if game %}Search {{ game.title }}{% else %}Search all games{% endif %}"
        hidden>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="M13.2 13.2 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        {#
          Just "Search" — the game's name is already in the header, and
          repeating it here is what crowded a long title out. The full phrase
          stays as the control's accessible name.
        #}
        <span class="search-trigger__label">Search</span>
        <kbd class="search-trigger__key" aria-hidden="true">⌘K</kbd>
      </button>

      <button
        type="button"
        class="icon-button"
        data-bookmarks-toggle
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Bookmarks"
        hidden>
        <svg viewBox="0 0 16 20" width="16" height="18" aria-hidden="true" focusable="false">
          <path d="M2.5 1.5h11a1 1 0 0 1 1 1v15.2a.6.6 0 0 1-.94.49L8 14.2l-5.56 4a.6.6 0 0 1-.94-.5V2.5a1 1 0 0 1 1-1Z"
                fill="none" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <span class="icon-button__badge" data-bookmarks-count hidden></span>
      </button>

      <button
        type="button"
        class="icon-button"
        data-preferences-toggle
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Reading preferences"
        hidden>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path d="M3 6h9M15 6h2M3 14h2M8 14h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <circle cx="13.5" cy="6" r="2.1" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="6.5" cy="14" r="2.1" fill="none" stroke="currentColor" stroke-width="1.7"/>
        </svg>
      </button>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        hidden
        aria-expanded="false"
        aria-controls="site-menu">
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  {# The narrow-viewport menu: everything the sidebar carries on a wide one. #}
  <div class="site-menu" id="site-menu" data-menu hidden>
    <div class="site-menu__inner">
      <nav class="site-menu__section" aria-label="Site">
        <p class="site-menu__heading">Site</p>
        <ul class="nav-list">
          <li><a class="nav-link{% if page.url == '/' %} is-current{% endif %}" href="/">All Games</a></li>
          <li><a class="nav-link{% if page.url == '/about/' %} is-current{% endif %}" href="/about/">About</a></li>
        </ul>
      </nav>

      {% if game %}
        {% from "partials/nav-macros.njk" import gameSections %}
        <nav class="site-menu__section" aria-label="{{ game.title }}">
          <p class="site-menu__heading">{{ game.title }}</p>
          {{ gameSections(game, page.url) }}
        </nav>
      {% endif %}
    </div>
  </div>
</header>
