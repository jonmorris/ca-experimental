{#
  Shared navigation fragments.

  The sidebar (wide viewports) and the header dropdown (narrow ones) show the
  same items, so they are defined once here and called from both.
#}

{% macro gameSections(game, currentUrl) %}
  <ul class="nav-list">
    <li>
      <a href="{{ game.url }}"
         class="nav-link{% if currentUrl == game.url %} is-current{% endif %}"
         {% if currentUrl == game.url %}aria-current="page"{% endif %}>Overview</a>
    </li>
    {% for type in game.contentTypes %}
      <li>
        <a href="{{ type.url }}"
           class="nav-link{% if currentUrl == type.url %} is-current{% endif %}"
           {% if currentUrl == type.url %}aria-current="page"{% endif %}>{{ type.label }}</a>
      </li>
    {% endfor %}
  </ul>

  {% for expansion in game.expansions %}
    <p class="nav-subheading">{{ expansion.title }}</p>
    <ul class="nav-list">
      {% for type in expansion.contentTypes %}
        <li>
          <a href="{{ type.url }}"
             class="nav-link{% if currentUrl == type.url %} is-current{% endif %}"
             {% if currentUrl == type.url %}aria-current="page"{% endif %}>{{ type.label }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
{% endmacro %}

{#
  The H2 list for the page being read. `data-jump-anchor` is what
  `section-nav.js` uses to mark the entry the reader is currently inside.
#}
{#
  The list itself, when the build knows the sections — and an empty one it can
  fill when it does not. My Reference is assembled in the browser out of the
  reader's bookmarks, so its sections exist a moment after the page does;
  `section-nav.js` fills any list marked `data-jump-list` that arrives empty.
#}
{% macro sectionList(contentType, listClass) %}
  <ol class="{{ listClass }}" data-jump-list
      {% if contentType %}data-jump-base="{{ contentType.url }}"{% endif %}>
    {% for section in contentType.sections %}
      <li>
        <a class="jump-link"
           href="{{ contentType.url }}#{{ section.slug }}"
           data-jump-anchor="{{ section.slug }}">
          <span class="jump-link__index" aria-hidden="true">{{ loop.index }}</span>
          <span class="jump-link__title">{{ section.title }}</span>
        </a>
      </li>
    {% endfor %}
  </ol>
{% endmacro %}
