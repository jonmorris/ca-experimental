{#
  The game's files: the publisher's own PDF, and anything made for this site.

  A list rather than the card grid above it, because these are not places to
  go — they are one thing each, and a card's worth of room around a filename
  says otherwise. Each row is a single target the width of the section, which
  is also what makes it a sane thing to hit on a phone.

  Format and size are stated before the reader commits to the tap. A rulebook
  PDF can be tens of megabytes, and on a phone on a train that is the one fact
  worth knowing in advance.
#}
<section class="landing__section" aria-labelledby="downloads-title">
  <h2 class="section-title" id="downloads-title">Downloads</h2>

  <ul class="download-list">
    {% for item in game.downloads %}
      <li class="download">
        {#
          `download` on our own files, so the button does what the heading
          says. It is deliberately not set on somebody else's: the attribute is
          ignored cross-origin anyway, and those links go where the publisher
          put them — the external-link rule opens them in a new tab like every
          other link that leaves the site.
        #}
        <a class="download__link" href="{{ item.url }}"{% if not item.external %} download{% endif %}>
          <span class="download__icon" aria-hidden="true">
            {% if item.external %}
              <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
                <path d="M7.5 4h8.5v8.5M16 4 9 11M13 11.5V16H4V7h4.5"
                      fill="none" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% else %}
              <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
                <path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M3.5 14v2.5h13V14"
                      fill="none" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </span>

          <span class="download__text">
            <span class="download__title">{{ item.title }}</span>
            {% if item.note %}<span class="download__note">{{ item.note }}</span>{% endif %}
          </span>

          {#
            Read as one phrase — "12.4 MB · PDF" — and hidden from assistive
            technology only as decoration would be, which it is not: it is
            repeated in the link's own label below, punctuated as a sentence
            rather than with a middot nobody wants read aloud.

            Size first, format last. The block is flush to the end of the row,
            so whichever fact is written last is the one that lines up down the
            list — and the format is the fact that repeats. With the format
            first it started at a different place on every row, because "820
            KB" and "12.4 MB" are different widths, and a column of PDFs
            zig-zagged. The size is a different number on every row anyway and
            loses nothing by moving.
          #}
          <span class="download__meta" aria-hidden="true">
            {{ item.size }}{% if item.format and item.size %} <span class="download__dot">·</span> {% endif %}{{ item.format }}
          </span>
        </a>

        <span class="visually-hidden">
          {%- if item.external %}Opens on another site.{% else %}Downloads {% endif -%}
          {%- if item.format %} {{ item.format }}{% endif -%}
          {%- if item.size %}, {{ item.size }}{% endif -%}.
        </span>
      </li>
    {% endfor %}
  </ul>
</section>
