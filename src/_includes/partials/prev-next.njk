{#
  Prev / next between rulebook sections, at the foot of the page.

  The bottom-pinned bar is gone: the sticky section bar at the top now answers
  "where am I" continuously, and two fixed bars competing for the same small
  screen was the wrong trade at a table. Targets are updated by section-nav.js
  as the reader scrolls; the server-rendered first and last sections stand in
  until it runs.
#}
{% macro prevNext(contentType, variant) %}
  {% set first = contentType.sections[0] %}
  {% set last = contentType.sections[contentType.sections.length - 1] %}
  <nav
    class="prev-next prev-next--{{ variant }}"
    aria-label="Rulebook section navigation"
    data-rulebook-nav
    data-pagefind-ignore
    data-rulebook-base="{{ contentType.url | basePath }}">
    <a class="prev-next__link prev-next__link--prev" href="{{ contentType.url }}#{{ first.slug }}" data-rulebook-prev>
      <span class="prev-next__direction">Previous</span>
      <span class="prev-next__label" data-rulebook-prev-label>{{ first.title }}</span>
    </a>
    <a class="prev-next__link prev-next__link--next" href="{{ contentType.url }}#{{ last.slug }}" data-rulebook-next>
      <span class="prev-next__direction">Next</span>
      <span class="prev-next__label" data-rulebook-next-label>{{ last.title }}</span>
    </a>
  </nav>
{% endmacro %}
